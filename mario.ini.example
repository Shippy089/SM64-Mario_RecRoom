# ---------------------------------------------------------------------------
#  Mario for Rec Room - settings
#
#  The easy way: run MarioLauncher and use its tabs. It edits this file for you.
#  You can also edit it by hand.
#  Lines that start with # are comments. Every setting is written as  key = value.
#  For switches, on/off, yes/no and true/false all work.
# ---------------------------------------------------------------------------

[paths]
# The folder that holds Recroom_Release.exe from an old IL2CPP Rec Room build (2019 to April 8, 2020; tested: September 9, 2019).
# The tested build is Steam depot 471711, manifest 3817258843939969587. See docs/INSTALL.md.
client = C:\Games\RecRoom-2019

# Your own Super Mario 64 (USA) ROM, in .z64 format. It is never copied or shared.
rom = C:\Games\sm64\baserom.us.z64

# Super Luigi 64 v2.0 (the .zip or its .ppf), for character = luigi. Empty: the one in characters\ is used, or one next to
# your ROM or in Downloads. The patch is applied in memory. No patched ROM is ever written.
luigi =

# The BepInEx 6 (IL2CPP, x64) folder or .zip. Only setup needs it. The release has it in BepInEx-pack\.
bepinex = BepInEx-pack\BepInEx-Unity.IL2CPP-win-x64-6.0.0-be.788.zip

# zig 0.17.0 (the compiler that builds the native Mario library during setup).
# Leave this empty if zig is on your PATH.
zig =

# Your libsm64 checkout (docs/INSTALL.md has the commands). Empty = native/libsm64.
libsm64 =

[start]
# What "Start" does when you pick nothing else:
#   play    - free play, in the Rec Center (or in the room set by hangout below)
#   quest   - start a quest (set quest below)
#   route   - Mario follows a route file by himself (set route below)
mode = play

# Start in another room instead of the Rec Center (mode = play only). Use the room's scene name, for example Park.
# The Map tab lists every room it finds in your client and sets this for you. Empty = the Rec Center.
# A scene that is only part of another room can't start by itself. The loading bar and the log say so.
hangout =

# golden-trophy, jumbotron, crimson-cauldron, lost-skulls or crescendo
quest = golden-trophy

# Start the quest right away instead of waiting at the quest door.
quest_autostart = yes

# The room to start the quest in (0 = the beginning). The Map tab sets this.
quest_room = 0

# The route file for mode = route (a file in the routes folder, or a full path).
route = golden-trophy-r1.json

[mario]
# Mario hits enemies, takes damage from them, and uses buttons, pots and traps.
combat = on

# Easier fights. Mario's hits reach 15 cm further, punches and kicks cover a wider angle,
# and hits push him back half as far. These aren't the real SM64 rules (off = the real rules). Needs combat.
casual = off

# SM64's power meter at the top of the screen (drawn from your own ROM).
health_meter = on

# Lava in the quests works like SM64 lava. Mario burns, hops up and loses health (his burnt-butt hop and "hot" voice),
# instead of the quest ending the moment he touches it. Off = the original rule, where lava kills him on contact.
sm64_lava = on

# The round SM64 shadow under Mario, on the floor below him. It shrinks and fades as he goes up.
shadow = on

# Mario can pick up and throw bombs, torches, lighters, jigsaw pieces,
# pallets and cannon handles.
carry = on

# SM64's Wing cap: a triple jump turns into flight, and the cap grows wings.
#   auto - worn while the original game lets you fly (the room allows it, or you hold the Maker Pen)
#   on   - always worn
#   off  - never worn
# The wings need the native library from this version (delete dist\native\sm64-mario.dll and run Setup to rebuild it).
# An older library logs mario-wing-cap-unavailable and Mario goes without wings. With immortal = on (below), Mario also
# wears the Metal cap. The two caps share one timer, so the Wing cap can linger while immortal is on.
wing_cap = auto

# Constant flying: with the Wing cap, Mario flies at one steady speed instead of SM64's own speed build-up and loss
# (no diving to gain speed, no stalling when climbing).
constant_flying = off

# Let the camera pick its own angles (made for routes). Off = it stays behind Mario and you steer it.
auto_camera = off

# Who Mario looks like: mario, or luigi (needs your Super Luigi 64 v2.0 patch, see [paths] luigi).
character = mario

# A skin from the skins folder next to the launcher (its file name without .marioskin), or empty for Mario's own body.
# The Mario tab lists them with their credits.
skin =

# Camera up and down: normal (moving the mouse or stick up looks up) or inverted.
camera_vertical = normal

# Camera left and right: normal or inverted.
camera_horizontal = normal

# Camera turning speed, 0.1 to 5 (1.0 = the original speed).
camera_sensitivity = 1.0

# Turn off Mario's voice and sounds.
mute = off

# Game controllers: N64 adapters, PlayStation, Xbox and other USB/Bluetooth gamepads play Mario with SM64's own N64
# layout (tables in docs/INSTALL.md). The keyboard keeps working. Whichever one you touch drives Mario.
#   auto - use the first controller found (plug it in any time)
#   off  - keyboard and mouse only
controller = auto

# How far you must push the stick before Mario reacts, from 0 to 0.8 (use a dot, like 0.2). Xbox pads never go below
# Microsoft's recommended 0.24 (left) and 0.27 (right).
controller_deadzone = 0.2

# Xbox pads shake when Mario gets hurt, dies or lands a ground pound. Other pads have no motors the mod can reach.
rumble = on

[advanced]
# You normally don't need to change anything below.

# The folder for logs and run reports. Empty = "logs" next to this file.
logs =

# TESTING ONLY: Mario can't die (and wears SM64's Metal cap). Scores from these runs don't count.
immortal = off

[launcher]
# How the launcher looks. theme: default, mario, soft or mono (no colours). accent: the cursor and the current tab:
# theme (the theme's own), cyan, green, yellow, blue, magenta, red, white, orange or sky.
theme = default
accent = theme

# The gradient on the author name: two to eight colours as hex, comma-separated, left to right.
gradient = ff9c09, ffe047, 05a4fa
# Use the same gradient on the "Mario for Rec Room" title too.
gradient_title = off
# The gradient scrolls. off keeps it still.
animations = on

# Tabs by name, comma-separated: their order, and which ones are hidden. Empty = the usual order, all shown.
# Play, Setup and Advanced are always shown. The Advanced tab changes these for you.
tab_order =
hidden_tabs =
